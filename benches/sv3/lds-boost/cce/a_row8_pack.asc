// A-row8: LDS shaped like the GEMV slab — 1024 rows × 16 B (K=8 fp16),
// all loads are u32 (half2 pairs, LDS.b32 = 128 B/warp issue). Three layouts:
//
// -DPACK=1  row-major u32: thread t owns rows t, t+T, … → lane stride 16 B
//           (exactly what build_ub_quad_acc emits today; bank-replay class)
// -DPACK=2  transposed u32: UB holds A^T (u32 index = tid + i*T) → lane
//           stride 4 B, conflict-free — "MTE2 pre-transposes, VF loads linear"
// -DPACK=0  flat strided u32 control (same load count, no row structure)
//
// Keep-alive: single u32 fold + one STS (anti-DCE only).
#ifndef SIMT_THREADS
#define SIMT_THREADS 256
#endif
#ifndef ROWS
#define ROWS 1024
#endif
#ifndef PACK
#define PACK 1
#endif

#include <tl_templates/ascend/common.h>
#include <tl_templates/ascend/debug.h>

constexpr int kThreads = SIMT_THREADS;
constexpr int kRows = ROWS;
constexpr int kPerThread = kRows / kThreads;              // rows per thread
constexpr int kU32 = kRows * 4;                           // slab u32 count
static_assert(kRows % kThreads == 0, "rows divisible by threads");
static_assert(kU32 % kThreads == 0, "u32 divisible by threads");
static_assert(kRows * 16 <= 248 * 1024, "UB");

__simt_vf__ __launch_bounds__(kThreads) inline void simt_vf(__ubuf__ uint8_t* buf) {
  const int tid = (int)threadIdx.x;
  __ubuf__ uint32_t* sink = (__ubuf__ uint32_t*)buf;
  uint32_t acc = 0;
  __ubuf__ uint32_t* src = (__ubuf__ uint32_t*)buf;

#if PACK == 1
  // GEMV-row shape (today's lowering): row = 4 × u32, lane stride 16 B.
  uint32_t v[kPerThread][4];
#pragma unroll
  for (int r = 0; r < kPerThread; ++r) {
    const int row = tid + r * kThreads;
#pragma unroll
    for (int j = 0; j < 4; ++j) v[r][j] = src[row * 4 + j];
  }
#pragma unroll
  for (int r = 0; r < kPerThread; ++r)
#pragma unroll
    for (int j = 0; j < 4; ++j) acc += v[r][j];
#elif PACK == 2
  // Transposed UB: u32 index = tid + i*T (pure-bench shape, same kU32 loads).
  constexpr int kLoads = kU32 / kThreads;
  uint32_t v[kLoads];
#pragma unroll
  for (int i = 0; i < kLoads; ++i) v[i] = src[tid + i * kThreads];
#pragma unroll
  for (int i = 0; i < kLoads; ++i) acc += v[i];
#else
  // Flat control: same kU32 loads, contiguous per thread.
  constexpr int kLoads = kU32 / kThreads;
  uint32_t v[kLoads];
#pragma unroll
  for (int i = 0; i < kLoads; ++i) v[i] = src[tid * kLoads + i];
#pragma unroll
  for (int i = 0; i < kLoads; ++i) acc += v[i];
#endif

  sink[tid] = acc;
}

extern "C" __global__ __vector__ void main_kernel(__gm__ uint8_t* dst, __gm__ uint8_t* src, __gm__ uint8_t* src1) {
  asc_init();
  __ubuf__ uint8_t* buf = (__ubuf__ uint8_t*)0;
  const int nbytes = kRows * 16;
  asc_copy_gm2ub_align(buf, src, 1, nbytes, 0, 0, 0, static_cast<asc_load_l2_cache_mode>(0), nbytes, nbytes);
  asc_sync_notify(PIPE_MTE2, PIPE_V, static_cast<event_t>(0));
  asc_sync_wait(PIPE_MTE2, PIPE_V, static_cast<event_t>(0));
  asc_vf_call<simt_vf>(cce::dim3(kThreads), buf);
  asc_sync_notify(PIPE_V, PIPE_MTE3, static_cast<event_t>(0));
  asc_sync_wait(PIPE_V, PIPE_MTE3, static_cast<event_t>(0));
  asc_copy_ub2gm_align(dst, buf, 1, kThreads * 4, static_cast<asc_store_l2_cache_mode>(4), kThreads * 4, kThreads * 4);
}

#ifdef _WIN32
#define TL_EXPORT __declspec(dllexport)
#else
#define TL_EXPORT
#endif
#define ERROR_BUF_SIZE 1024
static char error_buf[ERROR_BUF_SIZE];
extern "C" TL_EXPORT const char* get_last_error() { return error_buf; }
extern "C" TL_EXPORT int init() { error_buf[0] = '\0'; return 0; }
extern "C" TL_EXPORT int call(void* dst, void* src, void* stream) {
  main_kernel<<<1, 16384, stream>>>((__gm__ uint8_t*)dst, (__gm__ uint8_t*)src, (__gm__ uint8_t*)src);
  return 0;
}
