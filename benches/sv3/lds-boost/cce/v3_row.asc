// Hand-written CCE of the V3 schedule.
// One row-block at a time: load 4 packed u32 words, unpack, MAC with x, store.
// N=2048, K=8, 256 threads. Same host ABI as launch_flip.py (packT):
//   A is (K/2, N) uint32, word (c, n) = fp16 pair (A[2c, n], A[2c+1, n]).
// Unpack is a union bitcast, not TileLang's *(half*)(&v_) pun.

#include <tl_templates/ascend/common.h>

constexpr int kThreads = 256;
constexpr int kSlab = 1024;
constexpr int kKh = 4;
constexpr int kABytes = kKh * kSlab * 4;     // 16384
constexpr int kOutBytes = 2048 * 4;          // 8192
constexpr int kSmem = kABytes + kOutBytes + 16;

__simt_vf__ __launch_bounds__(kThreads) inline void v3_vf(__ubuf__ uint8_t* buf, int s) {
  __ubuf__ uint32_t* A = (__ubuf__ uint32_t*)buf;
  __ubuf__ float* Out = (__ubuf__ float*)(buf + kABytes);
  __ubuf__ half* X = (__ubuf__ half*)(buf + kABytes + kOutBytes);
  const int tid = (int)threadIdx.x;

  float x[8];
#pragma unroll
  for (int i = 0; i < 8; ++i) x[i] = (float)X[i];

  for (int q = 0; q < (kSlab / kThreads); ++q) {
    float acc = 0.f;
#pragma unroll
    for (int c = 0; c < kKh; ++c) {
      uint32_t w = A[(c * kSlab) + (q * kThreads) + tid];
      union {
        uint32_t u;
        half h[2];
      } p;
      p.u = w;
      acc += ((float)p.h[0]) * x[2 * c];
      acc += ((float)p.h[1]) * x[2 * c + 1];
    }
    Out[(s * kSlab) + (q * kThreads) + tid] = acc;
  }
}

extern "C" __global__ __vector__ void main_kernel(__gm__ uint32_t* A_t, __gm__ float* Out, __gm__ half* X) {
  asc_init();
  __ubuf__ uint8_t* buf = (__ubuf__ uint8_t*)0;
  asc_sync_notify(PIPE_V, PIPE_MTE2, static_cast<event_t>(0));
  asc_copy_gm2ub_align(buf + kABytes + kOutBytes, (__gm__ uint8_t*)X, 1, 16, 0, 0, 0,
                       static_cast<asc_load_l2_cache_mode>(0), 16, 16);
  for (int s = 0; s < 2; ++s) {
    asc_sync_wait(PIPE_V, PIPE_MTE2, static_cast<event_t>(0));
    asc_copy_gm2ub_align(buf, (__gm__ uint8_t*)(A_t + s * kSlab), 4, 4096, 0, 0, 0,
                         static_cast<asc_load_l2_cache_mode>(0), 8192, 4096);
    asc_sync_notify(PIPE_MTE2, PIPE_V, static_cast<event_t>(0));
    asc_sync_wait(PIPE_MTE2, PIPE_V, static_cast<event_t>(0));
    asc_vf_call<v3_vf>(cce::dim3(kThreads), buf, s);
    asc_sync_notify(PIPE_V, PIPE_MTE2, static_cast<event_t>(0));
    if (s == 1) asc_sync_notify(PIPE_V, PIPE_MTE3, static_cast<event_t>(0));
  }
  asc_sync_wait(PIPE_V, PIPE_MTE3, static_cast<event_t>(0));
  asc_copy_ub2gm_align((__gm__ uint8_t*)Out, buf + kABytes, 1, kOutBytes,
                       static_cast<asc_store_l2_cache_mode>(4), kOutBytes, kOutBytes);
  asc_sync_wait(PIPE_V, PIPE_MTE2, static_cast<event_t>(0));
}

#ifdef _WIN32
#define TL_EXPORT __declspec(dllexport)
#else
#define TL_EXPORT
#endif
#define ERROR_BUF_SIZE 1024
static char error_buf[ERROR_BUF_SIZE];
extern "C" TL_EXPORT const char* get_last_error() { return error_buf; }
extern "C" TL_EXPORT int init() { error_buf[0] = '\0'; return 0; }
extern "C" TL_EXPORT int call(void* a, void* x, void* o, void* stream) {
  main_kernel<<<(1 * 1 * 1), kSmem, stream>>>((__gm__ uint32_t*)a, (__gm__ float*)o, (__gm__ half*)x);
  return 0;
}
