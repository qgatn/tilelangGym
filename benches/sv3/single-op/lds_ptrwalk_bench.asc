// LDS pointer-walk bench — can we beat the strided peak by removing per-load
// address IADD_I from the LDS band?
//
// LDS_VARIANT:
//   0 = baseline strided   src[tid + i*kThreads]        (current SoT peak)
//   1 = pointer walk       p = src + tid; p += kThreads per iter (carried dep)
//   2 = unroll x4 strides  src[tid + (i + u*4)*kThreads] (same adds, batched)
//
// Keep-alive identical to lds_pure_burst.asc: integer fold + 1 STS/thread.

#ifndef SIMT_THREADS
#define SIMT_THREADS 256
#endif
#ifndef LDS_KIND
#define LDS_KIND 0
#endif
#ifndef LDS_N
#define LDS_N 49152
#endif
#ifndef LDS_VARIANT
#define LDS_VARIANT 0
#endif

#define KIND_FP32 0
#define KIND_BF16X2 2

constexpr int kThreads = SIMT_THREADS;
constexpr int kN = LDS_N;
constexpr int kUnits = kN;   // fp32 els OR bf16x2 pairs (both 4 B/unit)
constexpr int kPerThread = kUnits / kThreads;

static_assert(kN * 4 <= 248 * 1024, "UB");
static_assert(kUnits % kThreads == 0, "units divisible by threads");

#include <tl_templates/ascend/common.h>
#include <tl_templates/ascend/debug.h>

__simt_vf__ __launch_bounds__(kThreads) inline void simt_vf(__ubuf__ uint8_t* buf) {
  const int tid = (int)threadIdx.x;
  __ubuf__ uint32_t* sink = (__ubuf__ uint32_t*)buf;
  uint32_t acc = 0;

#if LDS_VARIANT == 1
  // Pointer walk: bump a pointer each iteration (32 lanes × 4 B = 128 B steps
  // per warp). Compiler may still emit IADD; trace decides.
  __ubuf__ uint32_t* p = (__ubuf__ uint32_t*)buf + tid;
  uint32_t v[kPerThread];
#pragma unroll
  for (int i = 0; i < kPerThread; ++i) {
    v[i] = *p;
    p += kThreads;
  }
#pragma unroll
  for (int i = 0; i < kPerThread; ++i) acc += v[i];
#elif LDS_VARIANT == 2
  // Unrolled x4 stride batch: i and i+1..3 use separately materialized indices.
  uint32_t v[kPerThread];
#pragma unroll
  for (int u = 0; u < kPerThread / 4; ++u) {
    const int base = (u * 4) * kThreads + tid;
    v[u * 4 + 0] = ((__ubuf__ uint32_t*)buf)[base];
    v[u * 4 + 1] = ((__ubuf__ uint32_t*)buf)[base + kThreads];
    v[u * 4 + 2] = ((__ubuf__ uint32_t*)buf)[base + 2 * kThreads];
    v[u * 4 + 3] = ((__ubuf__ uint32_t*)buf)[base + 3 * kThreads];
  }
#pragma unroll
  for (int i = 0; i < kPerThread; ++i) acc += v[i];
#else
  // Baseline strided
  uint32_t v[kPerThread];
#pragma unroll
  for (int i = 0; i < kPerThread; ++i) v[i] = ((__ubuf__ uint32_t*)buf)[tid + i * kThreads];
#pragma unroll
  for (int i = 0; i < kPerThread; ++i) acc += v[i];
#endif

  sink[tid] = acc;
}

extern "C" __global__ __vector__ void main_kernel(__gm__ uint8_t* dst, __gm__ uint8_t* src, __gm__ uint8_t* src1) {
  asc_init();
  __ubuf__ uint8_t* buf = (__ubuf__ uint8_t*)0;
  const int nbytes = kN * 4;
  asc_copy_gm2ub_align(buf, src, 1, nbytes, 0, 0, 0, static_cast<asc_load_l2_cache_mode>(0), nbytes, nbytes);
  asc_sync_notify(PIPE_MTE2, PIPE_V, static_cast<event_t>(0));
  asc_sync_wait(PIPE_MTE2, PIPE_V, static_cast<event_t>(0));
  asc_vf_call<simt_vf>(cce::dim3(kThreads), buf);
  asc_sync_notify(PIPE_V, PIPE_MTE3, static_cast<event_t>(0));
  asc_sync_wait(PIPE_V, PIPE_MTE3, static_cast<event_t>(0));
  asc_copy_ub2gm_align(dst, buf, 1, kThreads * 4, static_cast<asc_store_l2_cache_mode>(4), kThreads * 4, kThreads * 4);
}

#ifdef _WIN32
#define TL_EXPORT __declspec(dllexport)
#else
#define TL_EXPORT
#endif
#define ERROR_BUF_SIZE 1024
static char error_buf[ERROR_BUF_SIZE];
extern "C" TL_EXPORT const char* get_last_error() { return error_buf; }
extern "C" TL_EXPORT int init() { error_buf[0] = '\0'; return 0; }
extern "C" TL_EXPORT int call(void* dst, void* src, void* stream) {
  main_kernel<<<1, 16384, stream>>>((__gm__ uint8_t*)dst, (__gm__ uint8_t*)src, (__gm__ uint8_t*)src);
  return 0;
}
