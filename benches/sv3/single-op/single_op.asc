// Single-op SIMT microbenchmark, reset version.
// N = 8192 elements. One block of SIMT_THREADS threads. Each thread handles
// PER_THREAD = N / SIMT_THREADS consecutive elements, so a warp always touches
// 32 consecutive elements (stride-1 across lanes), and each thread has plenty
// of independent work in flight to hide latency.
//
// OP_LDS: load  PER_THREAD elems from UB, store them back to UB (sink).
// OP_STS: store 1.0f to PER_THREAD consecutive UB slots.
// OP_FFMA: dst[i] = a[i] * b[i] + c[i]   (elements/cycle, outputs)
// OP_F2F:  dst[i] = cvt(src[i])          (elements/cycle, in==out count)
//   fp32 variant: no-op guard (adds 0.0f) so the compiler keeps the chain
//   bf16 variant: __cvt_float(bfloat16)  (2 B in -> 4 B out)
//
// DT_FP32: float everywhere. DT_BF16: src operands are bf16, converted.

#ifndef SIMT_THREADS
#define SIMT_THREADS 256
#endif
#ifndef SIMT_OP
#define SIMT_OP 0
#endif
#ifndef SIMT_DT
#define SIMT_DT 0
#endif

#define OP_LDS 0
#define OP_STS 1
#define OP_FFMA 2
#define OP_F2F 3

#define DT_FP32 0
#define DT_BF16 1

#include <tl_templates/ascend/common.h>
#include <tl_templates/ascend/debug.h>

constexpr int kThreads = SIMT_THREADS;
constexpr int kN = 8192;
constexpr int kPerThread = kN / kThreads; // 64, 32, 16 for 128/256/512

#if SIMT_DT == DT_BF16
  // bf16 sources: 2 B/elem. LDS counts 2 B per element per lane.
  // LDS buffers: src (2B) + sink (4B out)  -> 8192*(2+4) = 48 KB
  // FFMA buffers: a,b,c bf16 (3*2B) + dst f32 (4B) -> 8192*10 = 80 KB
  // F2F buffers: src bf16 (2B) + dst f32 (4B) -> 48 KB
  #if SIMT_OP == OP_FFMA
    static_assert(kN * (3 * 2 + 4) <= 248 * 1024, "UB");
  #else
    static_assert(kN * (2 + 4) <= 248 * 1024, "UB");
  #endif
#else
  // fp32: 4 B/elem everywhere. LDS: src+sink 64 KB. FFMA: a,b,c,dst 128 KB. F2F: 64 KB.
  #if SIMT_OP == OP_FFMA
    static_assert(kN * 4 * 4 <= 248 * 1024, "UB");
  #else
    static_assert(kN * 4 * 2 <= 248 * 1024, "UB");
  #endif
#endif

__simt_vf__ __launch_bounds__(kThreads) inline void simt_vf(__ubuf__ uint8_t* buf) {
  const int tid = (int)threadIdx.x;
#if SIMT_OP == OP_LDS
  // Coalesced across lanes: thread t reads element t + i * threads, so a warp
  // touches 32 consecutive elements and the next iteration advances by
  // threads * dtsize bytes. Thread 0 -> 0xX, thread 1 -> 0xX + 4B, ...
  #if SIMT_DT == DT_BF16
  __ubuf__ bfloat16_t* src = (__ubuf__ bfloat16_t*)buf;
  __ubuf__ float* dst = (__ubuf__ float*)(buf + kN * 2);
  bfloat16_t v[kPerThread];
  #pragma unroll
  for (int i = 0; i < kPerThread; ++i) v[i] = src[tid + i * kThreads];
  #pragma unroll
  for (int i = 0; i < kPerThread; ++i) dst[tid + i * kThreads] = __cvt_float(v[i]);
  #else
  __ubuf__ float* src = (__ubuf__ float*)buf;
  __ubuf__ float* dst = (__ubuf__ float*)(buf + kN * 4);
  float v[kPerThread];
  #pragma unroll
  for (int i = 0; i < kPerThread; ++i) v[i] = src[tid + i * kThreads];
  #pragma unroll
  for (int i = 0; i < kPerThread; ++i) dst[tid + i * kThreads] = v[i];
  #endif
#elif SIMT_OP == OP_STS
  // stores go to the same region the host reads back: right after the source block
  #if SIMT_DT == DT_BF16
  __ubuf__ float* dst = (__ubuf__ float*)(buf + kN * 2);
  #else
  __ubuf__ float* dst = (__ubuf__ float*)(buf + kN * 4);
  #endif
  #pragma unroll
  for (int i = 0; i < kPerThread; ++i) dst[tid + i * kThreads] = 1.0f;
#elif SIMT_OP == OP_FFMA
  #if SIMT_DT == DT_BF16
  __ubuf__ bfloat16_t* a = (__ubuf__ bfloat16_t*)buf;
  __ubuf__ bfloat16_t* b = (__ubuf__ bfloat16_t*)(buf + kN * 2);
  __ubuf__ bfloat16_t* c = (__ubuf__ bfloat16_t*)(buf + kN * 4);
  __ubuf__ float* dst = (__ubuf__ float*)(buf + kN * 6);
  float va[kPerThread], vb[kPerThread], vc[kPerThread];
  #pragma unroll
  for (int i = 0; i < kPerThread; ++i) {
    va[i] = __cvt_float(a[tid * kPerThread + i]);
    vb[i] = __cvt_float(b[tid * kPerThread + i]);
    vc[i] = __cvt_float(c[tid * kPerThread + i]);
  }
  #pragma unroll
  for (int i = 0; i < kPerThread; ++i) dst[tid * kPerThread + i] = va[i] * vb[i] + vc[i];
  #else
  __ubuf__ float* a = (__ubuf__ float*)buf;
  __ubuf__ float* b = (__ubuf__ float*)(buf + kN * 4);
  __ubuf__ float* c = (__ubuf__ float*)(buf + kN * 8);
  __ubuf__ float* dst = (__ubuf__ float*)(buf + kN * 12);
  float va[kPerThread], vb[kPerThread], vc[kPerThread];
  #pragma unroll
  for (int i = 0; i < kPerThread; ++i) {
    va[i] = a[tid * kPerThread + i];
    vb[i] = b[tid * kPerThread + i];
    vc[i] = c[tid * kPerThread + i];
  }
  #pragma unroll
  for (int i = 0; i < kPerThread; ++i) dst[tid * kPerThread + i] = va[i] * vb[i] + vc[i];
  #endif
#else // OP_F2F
  #if SIMT_DT == DT_BF16
  __ubuf__ bfloat16_t* src = (__ubuf__ bfloat16_t*)buf;
  __ubuf__ float* dst = (__ubuf__ float*)(buf + kN * 2);
  bfloat16_t v[kPerThread];
  #pragma unroll
  for (int i = 0; i < kPerThread; ++i) v[i] = src[tid * kPerThread + i];
  #pragma unroll
  for (int i = 0; i < kPerThread; ++i) dst[tid * kPerThread + i] = __cvt_float(v[i]);
  #else
  // fp32 F2F: identity, add 0.0f to keep the chain
  __ubuf__ float* src = (__ubuf__ float*)buf;
  __ubuf__ float* dst = (__ubuf__ float*)(buf + kN * 4);
  float v[kPerThread];
  #pragma unroll
  for (int i = 0; i < kPerThread; ++i) v[i] = src[tid * kPerThread + i];
  #pragma unroll
  for (int i = 0; i < kPerThread; ++i) dst[tid * kPerThread + i] = v[i] + 0.0f;
  #endif
#endif
}

extern "C" __global__ __vector__ void main_kernel(__gm__ uint8_t* dst, __gm__ uint8_t* src, __gm__ uint8_t* src1) {
  asc_init();
  __ubuf__ uint8_t* buf = (__ubuf__ uint8_t*)0;
#if SIMT_OP == OP_FFMA
  // three input blocks of kN*dtsize then dst; sizes differ per dtype
  #if SIMT_DT == DT_BF16
  asc_copy_gm2ub_align(buf, src, 1, kN * 2, 0, 0, 0, static_cast<asc_load_l2_cache_mode>(0), kN * 2, kN * 2);
  asc_copy_gm2ub_align(buf + kN * 2, src1, 1, kN * 2, 0, 0, 0, static_cast<asc_load_l2_cache_mode>(0), kN * 2, kN * 2);
  asc_copy_gm2ub_align(buf + kN * 4, src1, 1, kN * 2, 0, 0, 0, static_cast<asc_load_l2_cache_mode>(0), kN * 2, kN * 2);
  #else
  asc_copy_gm2ub_align(buf, src, 1, kN * 4, 0, 0, 0, static_cast<asc_load_l2_cache_mode>(0), kN * 4, kN * 4);
  asc_copy_gm2ub_align(buf + kN * 4, src1, 1, kN * 4, 0, 0, 0, static_cast<asc_load_l2_cache_mode>(0), kN * 4, kN * 4);
  asc_copy_gm2ub_align(buf + kN * 8, src1, 1, kN * 4, 0, 0, 0, static_cast<asc_load_l2_cache_mode>(0), kN * 4, kN * 4);
  #endif
  asc_sync_notify(PIPE_MTE2, PIPE_V, static_cast<event_t>(0));
  asc_sync_wait(PIPE_MTE2, PIPE_V, static_cast<event_t>(0));
  asc_vf_call<simt_vf>(cce::dim3(kThreads), buf);
  asc_sync_notify(PIPE_V, PIPE_MTE3, static_cast<event_t>(0));
  asc_sync_wait(PIPE_V, PIPE_MTE3, static_cast<event_t>(0));
  #if SIMT_DT == DT_BF16
  asc_copy_ub2gm_align(dst, buf + kN * 6, 1, kN * 4, static_cast<asc_store_l2_cache_mode>(4), kN * 4, kN * 4);
  #else
  asc_copy_ub2gm_align(dst, buf + kN * 12, 1, kN * 4, static_cast<asc_store_l2_cache_mode>(4), kN * 4, kN * 4);
  #endif
#else
  #if SIMT_DT == DT_BF16
  asc_copy_gm2ub_align(buf, src, 1, kN * 2, 0, 0, 0, static_cast<asc_load_l2_cache_mode>(0), kN * 2, kN * 2);
  #else
  asc_copy_gm2ub_align(buf, src, 1, kN * 4, 0, 0, 0, static_cast<asc_load_l2_cache_mode>(0), kN * 4, kN * 4);
  #endif
  asc_sync_notify(PIPE_MTE2, PIPE_V, static_cast<event_t>(0));
  asc_sync_wait(PIPE_MTE2, PIPE_V, static_cast<event_t>(0));
  asc_vf_call<simt_vf>(cce::dim3(kThreads), buf);
  asc_sync_notify(PIPE_V, PIPE_MTE3, static_cast<event_t>(0));
  asc_sync_wait(PIPE_V, PIPE_MTE3, static_cast<event_t>(0));
  #if SIMT_DT == DT_BF16
  asc_copy_ub2gm_align(dst, buf + kN * 2, 1, kN * 4, static_cast<asc_store_l2_cache_mode>(4), kN * 4, kN * 4);
  #else
  asc_copy_ub2gm_align(dst, buf + kN * 4, 1, kN * 4, static_cast<asc_store_l2_cache_mode>(4), kN * 4, kN * 4);
  #endif
#endif
}

#ifdef _WIN32
#define TL_EXPORT __declspec(dllexport)
#else
#define TL_EXPORT
#endif
#define ERROR_BUF_SIZE 1024
static char error_buf[ERROR_BUF_SIZE];
extern "C" TL_EXPORT const char* get_last_error() { return error_buf; }
extern "C" TL_EXPORT int init() { error_buf[0] = '\0'; return 0; }
extern "C" TL_EXPORT int call(void* dst, void* src, void* stream) {
  main_kernel<<<1, 16384, stream>>>((__gm__ uint8_t*)dst, (__gm__ uint8_t*)src, (__gm__ uint8_t*)src);
  return 0;
}
