// Pure LDS bandwidth microbench — load band only.
// No F2F. No LOP3 checksum. Keep-alive is a single integer fold + one STS
// per thread (anti-DCE only). Charts should show LDS + address IADD (+ 1 STS).
//
// -DLDS_KIND=0  fp32 scalar   (LDS.b32 naturally)
// -DLDS_KIND=1  bf16 scalar   (LDS.b16)
// -DLDS_KIND=2  bf16x2 pack   (LDS.b32 via bfloat16x2_t)
// -DLDS_LAYOUT=0  strided     src[tid + i*THREADS]
// -DLDS_LAYOUT=1  contiguous  src[tid*WPT + i]   (aim: base+imm, fewer IADD)

#ifndef SIMT_THREADS
#define SIMT_THREADS 256
#endif
#ifndef LDS_KIND
#define LDS_KIND 0
#endif
#ifndef LDS_N
#define LDS_N 8192
#endif
#ifndef LDS_LAYOUT
#define LDS_LAYOUT 0
#endif

#define KIND_FP32 0
#define KIND_BF16 1
#define KIND_BF16X2 2
#define LAYOUT_STRIDED 0
#define LAYOUT_CONTIG 1

#include <tl_templates/ascend/common.h>
#include <tl_templates/ascend/debug.h>

constexpr int kThreads = SIMT_THREADS;
constexpr int kN = LDS_N;

// Units = number of LDS issues per block-thread-sweep.
// fp32/bf16 scalar: kN elements.
// bf16x2: kN pairs (2× bf16 elements) so issue count matches fp32 LDS.b32.
#if LDS_KIND == KIND_BF16X2
constexpr int kUnits = kN;          // 8192 × LDS.b32  (== fp32 issue count)
#else
constexpr int kUnits = kN;
#endif
constexpr int kPerThread = kUnits / kThreads;

#if LDS_KIND == KIND_FP32 || LDS_KIND == KIND_BF16X2
static_assert(kN * 4 <= 248 * 1024, "UB");   // 32 KB tile
#else
static_assert(kN * 2 <= 248 * 1024, "UB");   // 16 KB tile (bf16 scalar)
#endif
static_assert(kUnits % kThreads == 0, "units divisible by threads");

__simt_vf__ __launch_bounds__(kThreads) inline void simt_vf(__ubuf__ uint8_t* buf) {
  const int tid = (int)threadIdx.x;
  __ubuf__ uint32_t* sink = (__ubuf__ uint32_t*)buf;
  uint32_t acc = 0;

#if LDS_LAYOUT == LAYOUT_CONTIG
#define LDS_IDX(i) (tid * kPerThread + (i))
#else
#define LDS_IDX(i) (tid + (i) * kThreads)
#endif

#if LDS_KIND == KIND_FP32
  __ubuf__ float* src = (__ubuf__ float*)buf;
  float v[kPerThread];
#pragma unroll
  for (int i = 0; i < kPerThread; ++i) v[i] = src[LDS_IDX(i)];
#pragma unroll
  for (int i = 0; i < kPerThread; ++i) acc += *reinterpret_cast<uint32_t*>(&v[i]);

#elif LDS_KIND == KIND_BF16
  __ubuf__ bfloat16_t* src = (__ubuf__ bfloat16_t*)buf;
  bfloat16_t v[kPerThread];
#pragma unroll
  for (int i = 0; i < kPerThread; ++i) v[i] = src[LDS_IDX(i)];
#pragma unroll
  for (int i = 0; i < kPerThread; ++i) acc += (uint32_t)(*reinterpret_cast<uint16_t*>(&v[i]));

#else  // KIND_BF16X2
  __ubuf__ bfloat16x2_t* src = (__ubuf__ bfloat16x2_t*)buf;
  bfloat16x2_t w[kPerThread];
#pragma unroll
  for (int i = 0; i < kPerThread; ++i) w[i] = src[LDS_IDX(i)];
#pragma unroll
  for (int i = 0; i < kPerThread; ++i) acc += *reinterpret_cast<uint32_t*>(&w[i]);
#endif

  // One store per thread — only to prevent DCE of the loads.
  sink[tid] = acc;
}

extern "C" __global__ __vector__ void main_kernel(__gm__ uint8_t* dst, __gm__ uint8_t* src, __gm__ uint8_t* src1) {
  asc_init();
  __ubuf__ uint8_t* buf = (__ubuf__ uint8_t*)0;
#if LDS_KIND == KIND_FP32 || LDS_KIND == KIND_BF16X2
  const int nbytes = kN * 4;   // fp32 els or bf16x2 pairs — same 32 KB
#else
  const int nbytes = kN * 2;   // bf16 scalar
#endif
  asc_copy_gm2ub_align(buf, src, 1, nbytes, 0, 0, 0, static_cast<asc_load_l2_cache_mode>(0), nbytes, nbytes);
  asc_sync_notify(PIPE_MTE2, PIPE_V, static_cast<event_t>(0));
  asc_sync_wait(PIPE_MTE2, PIPE_V, static_cast<event_t>(0));
  asc_vf_call<simt_vf>(cce::dim3(kThreads), buf);
  asc_sync_notify(PIPE_V, PIPE_MTE3, static_cast<event_t>(0));
  asc_sync_wait(PIPE_V, PIPE_MTE3, static_cast<event_t>(0));
  asc_copy_ub2gm_align(dst, buf, 1, kThreads * 4, static_cast<asc_store_l2_cache_mode>(4), kThreads * 4, kThreads * 4);
}

#ifdef _WIN32
#define TL_EXPORT __declspec(dllexport)
#else
#define TL_EXPORT
#endif
#define ERROR_BUF_SIZE 1024
static char error_buf[ERROR_BUF_SIZE];
extern "C" TL_EXPORT const char* get_last_error() { return error_buf; }
extern "C" TL_EXPORT int init() { error_buf[0] = '\0'; return 0; }
extern "C" TL_EXPORT int call(void* dst, void* src, void* stream) {
  main_kernel<<<1, 16384, stream>>>((__gm__ uint8_t*)dst, (__gm__ uint8_t*)src, (__gm__ uint8_t*)src);
  return 0;
}
