// PURE single-op bursts for SV3 uarch — one source per op family.
// Sinks are checksum-only (acc + 1 STS per thread): no store-all, no extra
// converts in the window. F2F/FFMA preload via LDS (unavoidable) — the
// measured busy-union is the target opcode only; charts show that window.
//
// -DPURE_OP=0 LDS   -DPURE_KIND=0 fp16 scalar (64B)   KIND=1 uint32 pack (128B)
//                   KIND=2 half2 typed (128B)         KIND=3 bfloat16x2 typed (128B)
// -DPURE_OP=1 F2F   -DPURE_KIND=0 scalar __cvt_float        (32 el/issue)
//                   KIND=1 packed __half22float2 from regs (64, PRMT in band)
//                   KIND=2 uint32 preload + bitcast half2  (64, no PRMT)
//                   KIND=3 KIND=2 + asc_syncthreads        (barrier-aligned)
// -DPURE_OP=2 FFMA  -DPURE_KIND=0 scalar                   KIND=1 float2-src
//                   KIND=2 scalar + asc_syncthreads        (barrier-aligned)
// Work: LDS/FFMA N=8192 fixed; F2F uses 32 el/thread (N = 32*T).

#ifndef SIMT_THREADS
#define SIMT_THREADS 256
#endif
#ifndef PURE_OP
#define PURE_OP 0
#endif
#ifndef PURE_KIND
#define PURE_KIND 0
#endif

#define OP_LDS 0
#define OP_F2F 1
#define OP_FFMA 2

#define LDS_SCALAR 0
#define LDS_U32 1
#define LDS_HALF2 2
#define LDS_BF16X2 3

#include <tl_templates/ascend/common.h>
#include <tl_templates/ascend/debug.h>

constexpr int kThreads = SIMT_THREADS;
#if PURE_OP == OP_F2F
constexpr int kN = 32 * kThreads;          // fixed 32 el/thread
#else
constexpr int kN = 8192;
#endif
constexpr int kPerThread = kN / kThreads;

static_assert(kN % kThreads == 0, "N divisible by threads");
#if PURE_OP == OP_LDS && PURE_KIND == LDS_BF16X2
static_assert(kN % 4 == 0, "bf16x2 needs even pairs");
#endif

__simt_vf__ __launch_bounds__(kThreads) inline void simt_vf(__ubuf__ uint8_t* buf) {
  const int tid = (int)threadIdx.x;
  __ubuf__ float* sink = (__ubuf__ float*)buf;

#if PURE_OP == OP_LDS

#if PURE_KIND == LDS_SCALAR
  __ubuf__ half* src = (__ubuf__ half*)buf;
  half v[kPerThread];
#pragma unroll
  for (int i = 0; i < kPerThread; ++i) v[i] = src[tid + i * kThreads];
  uint32_t acc = 0;
#pragma unroll
  for (int i = 0; i < kPerThread; ++i) acc += *reinterpret_cast<uint16_t*>(&v[i]) + (uint32_t)i;
  sink[tid] = *reinterpret_cast<float*>(&acc);

#elif PURE_KIND == LDS_U32
  __ubuf__ uint32_t* src = (__ubuf__ uint32_t*)buf;
  uint32_t w[kPerThread / 2];
#pragma unroll
  for (int i = 0; i < kPerThread / 2; ++i) w[i] = src[tid + i * kThreads];
  uint32_t acc = 0;
#pragma unroll
  for (int i = 0; i < kPerThread / 2; ++i) acc += w[i] + (uint32_t)i;
  sink[tid] = *reinterpret_cast<float*>(&acc);

#elif PURE_KIND == LDS_HALF2
  __ubuf__ half2* src = (__ubuf__ half2*)buf;
  half2 w[kPerThread / 2];
#pragma unroll
  for (int i = 0; i < kPerThread / 2; ++i) w[i] = src[tid + i * kThreads];
  uint32_t acc = 0;
#pragma unroll
  for (int i = 0; i < kPerThread / 2; ++i) acc += *reinterpret_cast<uint32_t*>(&w[i]) + (uint32_t)i;
  sink[tid] = *reinterpret_cast<float*>(&acc);

#else  // LDS_BF16X2
  __ubuf__ bfloat16x2_t* src = (__ubuf__ bfloat16x2_t*)buf;
  bfloat16x2_t w[kPerThread / 2];
#pragma unroll
  for (int i = 0; i < kPerThread / 2; ++i) w[i] = src[tid + i * kThreads];
  uint32_t acc = 0;
#pragma unroll
  for (int i = 0; i < kPerThread / 2; ++i) acc += *reinterpret_cast<uint32_t*>(&w[i]) + (uint32_t)i;
  sink[tid] = *reinterpret_cast<float*>(&acc);
#endif

#elif PURE_OP == OP_F2F

  __ubuf__ half* src = (__ubuf__ half*)buf;
  __ubuf__ float* dst = (__ubuf__ float*)(buf + kN * 2);
#if PURE_KIND == LDS_SCALAR || PURE_KIND == LDS_U32
  // S1/S2: preload scalar halves (LDS), then pure F2F band
  float r[kPerThread];
  half v[kPerThread];
#pragma unroll
  for (int i = 0; i < kPerThread; ++i) v[i] = src[tid + i * kThreads];
#if PURE_KIND == LDS_SCALAR
#pragma unroll
  for (int i = 0; i < kPerThread; ++i) r[i] = __cvt_float(v[i]);  // S1: 32 el/issue
#pragma unroll
  for (int i = 0; i < kPerThread; ++i) dst[tid + i * kThreads] = r[i];
#else
#pragma unroll
  for (int i = 0; i < kPerThread / 2; ++i) {
    half2 h;
    ((half*)&h)[0] = v[2 * i];
    ((half*)&h)[1] = v[2 * i + 1];
    float2 f = __half22float2(h);  // S2: 64 el/issue, PRMT in band
    r[2 * i] = f.x;
    r[2 * i + 1] = f.y;
  }
#pragma unroll
  for (int i = 0; i < kPerThread; ++i) dst[tid + i * kThreads] = r[i];
#endif
#else
  // S3/S4: preload uint32 words (LDS), bitcast half2 — no PRMT
  __ubuf__ uint32_t* wsrc = (__ubuf__ uint32_t*)buf;
  uint32_t w[kPerThread / 2];
#pragma unroll
  for (int i = 0; i < kPerThread / 2; ++i) w[i] = wsrc[tid + i * kThreads];
  float2 r2[kPerThread / 2];  // whole-float2 slots: no SHFI packing in the band
#if PURE_KIND == LDS_U32 + 1  // S3
#pragma unroll
  for (int i = 0; i < kPerThread / 2; ++i) {
    uint32_t bits = w[i];  // local copy: avoids a SHFI per convert
    r2[i] = __half22float2(*reinterpret_cast<half2*>(&bits));  // pure F2F
  }
#else  // S4: barrier-align warps into AND out of the convert band
  asc_syncthreads();
#pragma unroll
  for (int i = 0; i < kPerThread / 2; ++i) {
    uint32_t bits = w[i];
    r2[i] = __half22float2(*reinterpret_cast<half2*>(&bits));
  }
  asc_syncthreads();  // band fully done before any post-band op issues
#endif
#endif
#if PURE_KIND == LDS_U32 + 1 || PURE_KIND == LDS_BF16X2
  // store: word w loaded from slot tid + i*T holds elements (2w, 2w+1)
#pragma unroll
  for (int i = 0; i < kPerThread / 2; ++i) {
    dst[2 * tid + 2 * i * kThreads] = r2[i].x;
    dst[2 * tid + 2 * i * kThreads + 1] = r2[i].y;
  }
#endif

#else  // OP_FFMA

  __ubuf__ half* a = (__ubuf__ half*)buf;
  __ubuf__ half* b = (__ubuf__ half*)(buf + kN * 2);
  __ubuf__ float* dst = (__ubuf__ float*)(buf + kN * 4);
  float r[kPerThread];
#if PURE_KIND <= 1
  // S1/S2: preload+convert (LDS+F2F), then pure FFMA band
  float va[kPerThread], vb[kPerThread];
#if PURE_KIND == 0
#pragma unroll
  for (int i = 0; i < kPerThread; ++i) {
    va[i] = __cvt_float(a[tid + i * kThreads]);
    vb[i] = __cvt_float(b[tid + i * kThreads]);
  }
#pragma unroll
  for (int i = 0; i < kPerThread; ++i) r[i] = va[i] * vb[i] + va[i];  // S1 scalar
#else
  // S2: packed preload (legacy Sched-2 shape: half2 per strided pair)
  float2 va2[kPerThread / 2], vb2[kPerThread / 2];
#pragma unroll
  for (int i = 0; i < kPerThread / 2; ++i) {
    const int base = tid + (2 * i) * kThreads;
    va2[i] = __half22float2(make_half2(a[base], a[base + kThreads]));
    vb2[i] = __half22float2(make_half2(b[base], b[base + kThreads]));
  }
#pragma unroll
  for (int i = 0; i < kPerThread / 2; ++i) {  // S2 float2-src (still scalar ISA)
    r[2 * i] = va2[i].x * vb2[i].x + va2[i].x;
    r[2 * i + 1] = va2[i].y * vb2[i].y + va2[i].y;
  }
#endif
#else
  // S3: barrier-align warps into the multiply band
  float va[kPerThread], vb[kPerThread];
#pragma unroll
  for (int i = 0; i < kPerThread; ++i) {
    va[i] = __cvt_float(a[tid + i * kThreads]);
    vb[i] = __cvt_float(b[tid + i * kThreads]);
  }
  asc_syncthreads();
#pragma unroll
  for (int i = 0; i < kPerThread; ++i) r[i] = va[i] * vb[i] + va[i];
  asc_syncthreads();  // band fully done before any post-band op issues
#endif
#pragma unroll
  for (int i = 0; i < kPerThread; ++i) dst[tid + i * kThreads] = r[i];
#endif
}

extern "C" __global__ __vector__ void main_kernel(__gm__ uint8_t* dst, __gm__ uint8_t* src, __gm__ uint8_t* src1) {
  asc_init();
  __ubuf__ uint8_t* buf = (__ubuf__ uint8_t*)0;
#if PURE_OP == OP_FFMA
  asc_copy_gm2ub_align(buf, src, 1, kN * 2, 0, 0, 0, static_cast<asc_load_l2_cache_mode>(0), kN * 2, kN * 2);
  asc_copy_gm2ub_align(buf + kN * 2, src1, 1, kN * 2, 0, 0, 0, static_cast<asc_load_l2_cache_mode>(0), kN * 2, kN * 2);
#elif PURE_OP == OP_LDS && PURE_KIND == LDS_SCALAR
  asc_copy_gm2ub_align(buf, src, 1, kN * 2, 0, 0, 0, static_cast<asc_load_l2_cache_mode>(0), kN * 2, kN * 2);
#else
  asc_copy_gm2ub_align(buf, src, 1, kN * 2, 0, 0, 0, static_cast<asc_load_l2_cache_mode>(0), kN * 2, kN * 2);
#endif
  asc_sync_notify(PIPE_MTE2, PIPE_V, static_cast<event_t>(0));
  asc_sync_wait(PIPE_MTE2, PIPE_V, static_cast<event_t>(0));
  asc_vf_call<simt_vf>(cce::dim3(kThreads), buf);
  asc_sync_notify(PIPE_V, PIPE_MTE3, static_cast<event_t>(0));
  asc_sync_wait(PIPE_V, PIPE_MTE3, static_cast<event_t>(0));
#if PURE_OP == OP_LDS
  // checksum only: kThreads floats
  asc_copy_ub2gm_align(dst, buf, 1, kThreads * 4, static_cast<asc_store_l2_cache_mode>(4), kThreads * 4, kThreads * 4);
#else
  // F2F/FFMA full result tile (needed to verify the convert/multiply outputs)
  asc_copy_ub2gm_align(dst, buf + (PURE_OP == OP_F2F ? kN * 2 : kN * 4), 1, kN * 4,
                       static_cast<asc_store_l2_cache_mode>(4), kN * 4, kN * 4);
#endif
}

#ifdef _WIN32
#define TL_EXPORT __declspec(dllexport)
#else
#define TL_EXPORT
#endif
#define ERROR_BUF_SIZE 1024
static char error_buf[ERROR_BUF_SIZE];
extern "C" TL_EXPORT const char* get_last_error() { return error_buf; }
extern "C" TL_EXPORT int init() { error_buf[0] = '\0'; return 0; }
extern "C" TL_EXPORT int call(void* dst, void* src, void* stream) {
  main_kernel<<<1, 16384, stream>>>((__gm__ uint8_t*)dst, (__gm__ uint8_t*)src, (__gm__ uint8_t*)src);
  return 0;
}
